---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base title="Page not found — Elroni Quiñones" description="This page doesn't exist." loader={false}>
  <main id="main" class="nf container">
    <p class="mono nf-code">404</p>
    <h1 class="display nf-title">This page wandered off.</h1>
    <p class="nf-text">The link may be old or mistyped. Everything worth seeing is on the home page.</p>
    <a class="btn btn-primary" href={base}>Back to the portfolio</a>
  </main>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 1rem; max-width: 640px; }
  .nf-code { color: var(--accent); font-size: 0.9rem; }
  .nf-title { font-size: clamp(2.6rem, 7vw, 4rem); }
  .nf-text { color: var(--muted); margin-bottom: 0.5rem; }
</style>
