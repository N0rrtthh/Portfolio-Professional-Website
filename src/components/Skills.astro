---
import { skills } from "../data/site";
---
<section id="skills" class="section container skills" aria-labelledby="skills-title">
  <div class="section-head">
    <h2 id="skills-title" class="section-title">Skills</h2>
    <p class="section-lede">Tools I have used in the projects and internship above — not a wish list.</p>
  </div>
  <dl class="skill-table card">
    {skills.map((s) => (
      <div class="skill-row">
        <dt>{s.group}</dt>
        <dd>
          <ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .skills { padding-bottom: 0; }
  .skill-table { margin: 0; padding: 0.35rem 1.25rem; }
  .skill-row { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; align-items: center; padding-block: 0.85rem; border-bottom: 1px solid var(--line); }
  .skill-row:last-child { border-bottom: 0; }
  .skill-row dt { font-weight: 600; font-size: 0.92rem; }
  .skill-row dd { margin: 0; }
  @media (max-width: 640px) {
    .skill-table { padding-inline: 1rem; }
    .skill-row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
