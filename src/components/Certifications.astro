---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { certifications, certificationTotal } from "../data/site";

/* Badge art lives in src/assets/badges/<slug>.webp (saved locally from
   Credly, so the page makes no third-party image requests). */
const files = import.meta.glob<ImageMetadata>("../assets/badges/*.webp", { eager: true, import: "default" });
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
const badgeFor = (t: string) => files[`../assets/badges/${slug(t)}.webp`];

const featured = certifications.filter((c) => c.featured);
const more = certifications.filter((c) => !c.featured);
---
<section id="certifications" class="section container" aria-labelledby="certs-title">
  <div class="section-head reveal-head">
    <h2 id="certs-title" class="section-title reveal-title">Certifications</h2>
    <p class="section-lede reveal" style="--i:1">{certificationTotal} credentials from Cisco, IBM SkillsBuild and DICT — the most relevant first. Each links to its Credly verification.</p>
  </div>

  <ul class="featured" role="list">
    {featured.map((c, i) => {
      const badge = badgeFor(c.title);
      return (
        <li class="reveal" style={`--i:${i}`}>
          <a class="cert card" href={c.href} target="_blank" rel="noopener noreferrer">
            <span class="badge">
              {badge && <Image src={badge} alt="" width={96} height={96} densities={[1, 2]} loading="lazy" />}
            </span>
            <span class="cert-title">{c.title}</span>
            <span class="cert-meta">{c.issuer} · {c.year}</span>
            <span class="cert-verify">Verify on Credly <Icon name="arrowUpRight" size={14} /></span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
      );
    })}
  </ul>

  <details class="more reveal" style="--i:2">
    <summary class="btn btn-ghost btn-sm">
      <span class="s-closed">Show {more.length} more</span>
      <span class="s-open">Show fewer</span>
      <Icon name="chevron" size={16} />
    </summary>
    <ul class="mini" role="list">
      {more.map((c) => {
        const badge = badgeFor(c.title);
        return (
          <li>
            <a class="mini-cert card" href={c.href} target="_blank" rel="noopener noreferrer">
              {badge && <Image src={badge} alt="" width={44} height={44} densities={[1, 2]} loading="lazy" class="mini-badge" />}
              <span class="mini-text">
                <span class="mini-title">{c.title}</span>
                <span class="cert-meta">{c.issuer}</span>
              </span>
              <Icon name="arrowUpRight" size={14} />
              <span class="sr-only">Verify on Credly (opens in new tab)</span>
            </a>
          </li>
        );
      })}
    </ul>
  </details>
</section>

<style>
  .featured { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .featured li { display: flex; }
  .cert {
    display: flex; flex-direction: column; gap: 0.35rem; width: 100%;
    padding: 1.1rem 1.1rem 1rem; text-decoration: none;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease, border-color 0.2s ease;
  }
  @media (hover: hover) {
    .cert:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--line-strong); }
    .cert:hover .badge :global(img) { transform: rotate(-4deg) scale(1.05); }
  }
  .badge { width: 96px; height: 96px; margin-bottom: 0.6rem; }
  .badge :global(img) { width: 96px; height: 96px; object-fit: contain; transition: transform 0.45s var(--ease-out); filter: drop-shadow(0 8px 14px rgb(20 20 20 / 0.14)); }
  .cert-title { font-weight: 650; font-size: 0.95rem; line-height: 1.35; letter-spacing: -0.01em; }
  .cert-meta { color: var(--muted); font-size: 0.8rem; }
  .cert-verify { margin-top: auto; padding-top: 0.7rem; display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 600; font-size: 0.82rem; color: var(--accent); }

  .more { margin-top: 1.1rem; }
  .more summary { list-style: none; width: fit-content; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary :global(svg) { transition: transform 0.25s var(--ease-out); }
  .more[open] summary :global(svg) { transform: rotate(180deg); }
  .more .s-open, .more[open] .s-closed { display: none; }
  .more[open] .s-open { display: inline; }
  .mini { margin-top: 1rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; padding: 0; list-style: none; }
  .more[open] .mini { animation: mini-in 0.45s var(--ease-out); }
  @keyframes mini-in { from { opacity: 0; transform: translateY(8px); } }
  .mini-cert {
    display: grid; grid-template-columns: 44px minmax(0, 1fr) 14px; gap: 0.75rem; align-items: center;
    padding: 0.6rem 0.8rem; text-decoration: none; height: 100%;
    transition: border-color 0.2s ease, transform 0.25s var(--ease-out);
  }
  .mini-cert:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  .mini-cert:hover .mini-title { color: var(--accent); }
  .mini-cert :global(.mini-badge) { width: 44px; height: 44px; object-fit: contain; }
  .mini-cert > :global(svg) { color: var(--muted); }
  .mini-text { display: grid; gap: 0.1rem; min-width: 0; }
  .mini-title { font-weight: 600; font-size: 0.85rem; line-height: 1.3; }

  @media (max-width: 980px) {
    .featured { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mini { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .featured { gap: 0.7rem; }
    .cert { padding: 0.9rem; }
    .badge, .badge :global(img) { width: 72px; height: 72px; }
    .mini { grid-template-columns: 1fr; }
  }
</style>
