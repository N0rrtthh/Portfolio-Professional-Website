---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import bidabossPortal from "../assets/bidaboss-portal.webp";
import bidabossMobile from "../assets/bidaboss-mobile-dashboard.webp";
import waterwise from "../assets/waterwise.webp";
import quickAttend from "../assets/quick-attend.webp";
import resumaker from "../assets/resumaker.webp";
import creativePortfolio from "../assets/Creative_portfolio.webp";
import north from "../assets/North.webp";

/* Add a screenshot: drop it in src/assets, import it here, and use its key
   as `image` / `phoneImage` in src/data/site.ts. */
const IMAGES: Record<string, ImageMetadata> = {
  "bidaboss-portal": bidabossPortal,
  "bidaboss-mobile-dashboard": bidabossMobile,
  waterwise,
  "quick-attend": quickAttend,
  resumaker,
  "creative-portfolio": creativePortfolio,
  north,
};

interface Props {
  image?: string;
  phoneImage?: string;
  alt: string;
  large?: boolean;
}
const { image, phoneImage, alt, large = false } = Astro.props;
const main = image ? IMAGES[image] : undefined;
const phone = phoneImage ? IMAGES[phoneImage] : undefined;
const widths = large ? [640, 960, 1280] : [400, 640, 960];
const sizes = large ? "(max-width: 900px) 100vw, 860px" : "(max-width: 860px) 100vw, 540px";
---
<div class:list={["media", { "media-large": large }]}>
  {main ? (
    <Picture
      src={main}
      alt={alt}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="media-img"
    />
  ) : (
    <div class="media-empty" aria-hidden="true"></div>
  )}
  {phone && (
    <div class="media-phone">
      <Picture
        src={phone}
        alt={`${alt} — mobile app screen`}
        formats={["avif"]}
      fallbackFormat="webp"
        widths={large ? [220, 440] : [140, 280]}
        sizes={large ? "220px" : "140px"}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
</div>

<style>
  .media {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden;
    background: var(--surface-2); border-bottom: 1px solid var(--line);
  }
  .media > :global(picture) { display: block; width: 100%; height: 100%; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .media-empty { width: 100%; height: 100%; }
  .media-phone {
    position: absolute; right: 5%; bottom: -14%; width: 24%;
    aspect-ratio: 898 / 2000; border-radius: 16% / 7.5%; overflow: hidden;
    border: 4px solid #0b0b0c; background: #0b0b0c;
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.55);
    transform: rotate(4deg);
  }
  .media-phone :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 13% / 6%; }
  .media-large { border-radius: 10px; border: 1px solid var(--line); aspect-ratio: 16 / 9; }
  .media-large .media-phone { width: 19%; bottom: -10%; }
</style>
