---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import portrait from "../assets/portrait.jpg";
import { profile, education, experience, certificationTotal } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const [first, ...rest] = profile.name.split(" ");
const job = experience[0];
const school = education[0];

const facts = [
  { icon: "briefcase" as const, k: "Experience", v: `${job.role.replace(" (OJT)", "")}`, s: `${job.org} · ${job.period}` },
  { icon: "cap" as const, k: "Education", v: school.degree, s: `${school.school.replace(" – Main Campus", "")} · ${school.period}` },
  { icon: "code" as const, k: "Thesis", v: "WaterWise — offline multiplayer game", s: "Godot · Android · defended 2026" },
  { icon: "award" as const, k: "Credentials", v: `${certificationTotal} certifications`, s: "Cisco · IBM SkillsBuild · DICT" },
];
---
<section class="hero container" aria-labelledby="hero-name">
  <div class="hero-copy">
    {profile.openToWork && (
      <p class="status hero-step" style="--i:0"><span class="status-dot" aria-hidden="true"></span>{profile.availability}</p>
    )}
    <h1 id="hero-name" class="display hero-name hero-step" style="--i:1">
      {first} <em>{rest.join(" ")}</em>
    </h1>
    <p class="hero-role hero-step" style="--i:2">
      {profile.headline.split(" | ").map((part, i) => (
        <>{i > 0 && <span class="sep" aria-hidden="true">/</span>}<span>{part}</span></>
      ))}
    </p>
    <p class="hero-intro hero-step" style="--i:3">{profile.intro}</p>

    <ul class="tags hero-areas hero-step" style="--i:4" aria-label="Core areas">
      {profile.coreAreas.map((a) => <li class="tag">{a}</li>)}
    </ul>

    <div class="hero-cta hero-step" style="--i:5">
      <a class="btn btn-primary" href="#projects">View projects <Icon name="arrowRight" /></a>
      <a class="btn btn-ghost" href={`${base}${profile.resumeFile}`} download>
        <Icon name="download" /> Download resume
      </a>
      <a class="text-link" href="#contact">Contact me <Icon name="arrowUpRight" /></a>
    </div>
  </div>

  <aside class="sheet card hero-step" style="--i:3" aria-label="Profile at a glance">
    <div class="sheet-head">
      <Image
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        widths={[112, 224]}
        sizes="112px"
        loading="eager"
        fetchpriority="high"
        class="sheet-photo"
      />
      <div class="sheet-id">
        <p class="sheet-name">{profile.name}</p>
        <p class="sheet-title">Software Developer</p>
        <p class="sheet-loc"><Icon name="pin" size={14} /> {profile.location}</p>
      </div>
    </div>

    <dl class="facts">
      {facts.map((f) => (
        <div class="fact">
          <dt><Icon name={f.icon} size={16} /> {f.k}</dt>
          <dd>
            <span class="fact-v">{f.v}</span>
            <span class="fact-s">{f.s}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="sheet-links">
      <a class="icon-btn" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub — ${profile.githubHandle} (opens in new tab)`}>
        <Icon name="github" />
      </a>
      <a class="icon-btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile (opens in new tab)">
        <Icon name="linkedin" />
      </a>
      <a class="sheet-mail" href={`mailto:${profile.email}`}>
        <Icon name="mail" size={16} /> {profile.email}
      </a>
    </div>
  </aside>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
    padding-block: clamp(2rem, 7vh, 4.75rem) clamp(1.5rem, 4vh, 2.75rem);
  }
  .status {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface);
    font-size: 0.82rem; font-weight: 550; color: var(--ink-2);
    margin-bottom: 1.4rem;
  }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
  .hero-name { font-size: clamp(2.7rem, 6.4vw, 4.75rem); }
  .hero-name em { font-style: normal; font-weight: 500; color: var(--muted); }
  .hero-role { margin-top: 1.1rem; font-weight: 600; font-size: clamp(1rem, 1.6vw, 1.15rem); letter-spacing: -0.01em; color: var(--ink); }
  .hero-role { display: flex; flex-wrap: wrap; gap: 0.1rem 0.55rem; }
  .sep { color: var(--accent); font-weight: 500; }
  .hero-intro { margin-top: 0.75rem; max-width: 54ch; color: var(--muted); font-size: 1.025rem; }
  .hero-areas { margin-top: 1.4rem; }
  .hero-cta { margin-top: 1.9rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.75rem; }
  .hero-cta .text-link { margin-left: 0.4rem; }

  .sheet { padding: 1.25rem; box-shadow: var(--shadow-lg); }
  .sheet-head { display: flex; gap: 1rem; align-items: center; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line); }
  .sheet-head :global(.sheet-photo) { width: 92px; height: 92px; border-radius: 12px; object-fit: cover; background: var(--surface-2); flex: none; }
  .sheet-name { font: 650 1.3rem/1.1 var(--font-display); letter-spacing: -0.025em; }
  .sheet-title { margin-top: 0.2rem; font-weight: 550; font-size: 0.9rem; }
  .sheet-loc { margin-top: 0.35rem; display: flex; align-items: center; gap: 0.3rem; color: var(--muted); font-size: 0.82rem; }
  .sheet-loc :global(svg) { flex: none; }

  .facts { display: grid; gap: 0; margin: 0; }
  .fact { display: grid; grid-template-columns: 7.4rem 1fr; gap: 0.75rem; padding-block: 0.8rem; border-bottom: 1px solid var(--line); }
  .fact dt { display: flex; align-items: center; gap: 0.45rem; align-self: start; padding-top: 0.1rem; color: var(--muted); font-size: 0.8rem; font-weight: 550; }
  .fact dd { margin: 0; display: grid; gap: 0.1rem; min-width: 0; }
  .fact-v { font-weight: 600; font-size: 0.9rem; line-height: 1.35; }
  .fact-s { color: var(--muted); font-size: 0.8rem; }

  .sheet-links { display: flex; align-items: center; gap: 0.5rem; padding-top: 1rem; }
  .sheet-mail {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-left: auto; min-height: 40px;
    font-size: 0.85rem; font-weight: 550; text-decoration: none; color: var(--ink-2); overflow-wrap: anywhere;
  }
  .sheet-mail:hover { color: var(--accent); }
  .sheet-mail :global(svg) { flex: none; }

  @media (max-width: 920px) {
    .hero { grid-template-columns: 1fr; }
    .sheet { max-width: 560px; }
  }
  @media (max-width: 480px) {
    .hero-cta .btn { flex: 1 1 100%; }
    .hero-cta .text-link { margin-left: 0; }
    .fact { grid-template-columns: 1fr; gap: 0.25rem; }
    .sheet-links { flex-wrap: wrap; }
    .sheet-mail { margin-left: 0; flex-basis: 100%; }
  }
</style>
