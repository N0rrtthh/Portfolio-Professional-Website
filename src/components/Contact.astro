---
import Icon from "./Icon.astro";
import { profile } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const year = new Date().getFullYear();
---
<section id="contact" class="section container" aria-labelledby="contact-title">
  <div class="cta card">
    <div class="cta-copy">
      <h2 id="contact-title" class="display cta-title">Have a role or project in mind?</h2>
      <p class="cta-text">I'd be happy to discuss how I can contribute to your team. Email is the fastest way to reach me.</p>
    </div>

    <div class="cta-actions">
      <div class="mail-row">
        <a class="btn btn-accent mail-btn" href={`mailto:${profile.email}`}>
          <Icon name="mail" /> <span data-copy-target>{profile.email}</span>
        </a>
        <button class="icon-btn copy-btn" type="button" data-copy={profile.email} aria-label="Copy email address">
          <Icon name="copy" class="i-copy" />
          <Icon name="check" class="i-check" />
          <span class="copy-label" data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
      <div class="cta-links">
        <a class="btn btn-ghost" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" /> LinkedIn<span class="sr-only"> (opens in new tab)</span>
        </a>
        <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" /> GitHub<span class="sr-only"> (opens in new tab)</span>
        </a>
        <a class="btn btn-ghost" href={`${base}${profile.resumeFile}`} download>
          <Icon name="download" /> Résumé (PDF)
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="footer container">
  <p>© {year} {profile.name}</p>
  <p class="footer-right">
    <span>{profile.location}</span>
    <a href="#top">Back to top</a>
  </p>
</footer>

<style>
  .cta {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem 3rem; align-items: center;
    padding: clamp(1.5rem, 4vw, 2.75rem); box-shadow: var(--shadow);
  }
  .cta-title { font-size: clamp(2.2rem, 4.6vw, 3.4rem); }
  .cta-text { margin-top: 0.9rem; color: var(--muted); max-width: 44ch; }
  .cta-actions { display: grid; gap: 0.75rem; justify-items: start; }
  .mail-row { display: flex; gap: 0.5rem; align-items: center; max-width: 100%; }
  .mail-btn { --h: 52px; padding-inline: 1.3rem; font-size: 1rem; min-width: 0; }
  .mail-btn span { overflow: hidden; text-overflow: ellipsis; }
  .copy-btn { width: auto; height: 52px; padding-inline: 0.95rem; gap: 0.4rem; display: inline-flex; align-items: center; font-size: 0.85rem; font-weight: 600; }
  .copy-btn :global(.i-check) { display: none; color: var(--ok); }
  .copy-btn[data-state="copied"] :global(.i-check) { display: block; }
  .copy-btn[data-state="copied"] :global(.i-copy) { display: none; }
  .copy-btn[data-state="error"] { border-color: var(--line-strong); }
  .cta-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem;
    padding-block: 1.75rem 2.5rem; color: var(--muted); font-size: 0.85rem;
  }
  .footer-right { display: flex; gap: 1.25rem; }
  .footer a { color: var(--ink-2); }

  @media (max-width: 860px) {
    .cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .mail-row { width: 100%; }
    .mail-btn { flex: 1; font-size: 0.9rem; padding-inline: 1rem; }
    .copy-label { display: none; }
    .copy-btn { width: 52px; padding: 0; justify-content: center; }
    .cta-links { width: 100%; }
    .cta-links .btn { flex: 1 1 auto; }
  }
</style>
