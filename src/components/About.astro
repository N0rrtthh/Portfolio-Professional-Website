---
import Icon from "./Icon.astro";
import { education, experience, leadership, certifications, certificationTotal } from "../data/site";
const featured = certifications.filter((c) => c.featured);
const more = certifications.filter((c) => !c.featured);
---
<section id="about" class="section container" aria-labelledby="about-title">
  <div class="section-head">
    <h2 id="about-title" class="section-title">About</h2>
  </div>

  <div class="about-grid">
    <div class="about-bio">
      <p class="bio-lead">
        I'm a Computer Science student at Cavite State University who likes building software people actually use.
      </p>
      <p>
        During my internship at BidaBoss Inc. I shipped a franchise order portal that the company still runs today, and for my thesis I co-built WaterWise — an offline multiplayer game tuned to run smoothly on low-spec Android phones.
      </p>
      <p>
        I learn by building: read the docs, ship a working version, then measure it and make it better. I'm looking for an entry-level role where I can do that on a real team.
      </p>
    </div>

    <div class="about-col">
      <h3 class="col-title"><Icon name="briefcase" size={16} /> Experience</h3>
      <ul class="timeline" role="list">
        {experience.map((e) => (
          <li>
            <p class="t-role">{e.role}</p>
            <p class="t-meta">{e.org} · {e.place} · <span class="num">{e.period}</span></p>
          </li>
        ))}
      </ul>

      <h3 class="col-title"><Icon name="cap" size={16} /> Education</h3>
      <ul class="timeline" role="list">
        {education.map((e) => (
          <li>
            <p class="t-role">{e.degree}</p>
            <p class="t-meta">{e.school} · <span class="num">{e.period}</span></p>
            {e.note && <p class="t-note">{e.note}</p>}
          </li>
        ))}
      </ul>

      <h3 class="col-title">Leadership & communities</h3>
      <ul class="timeline compact" role="list">
        {leadership.map((l) => (
          <li>
            <p class="t-role">{l.role}</p>
            <p class="t-meta">{l.org} · <span class="num">{l.period}</span></p>
          </li>
        ))}
      </ul>
    </div>

    <div class="about-col">
      <h3 class="col-title"><Icon name="award" size={16} /> Certifications</h3>
      <ul class="certs" role="list">
        {featured.map((c) => (
          <li>
            <a href={c.href} target="_blank" rel="noopener noreferrer">
              <span class="c-title">{c.title}</span>
              <span class="c-meta">{c.issuer} · {c.year}</span>
              <Icon name="arrowUpRight" size={15} />
              <span class="sr-only">— verify on Credly (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
      <details class="more">
        <summary>
          <span class="s-closed">Show {more.length} more</span>
          <span class="s-open">Show fewer</span>
          <Icon name="chevron" size={16} />
        </summary>
        <ul class="certs certs-more" role="list">
          {more.map((c) => (
            <li>
              <a href={c.href} target="_blank" rel="noopener noreferrer">
                <span class="c-title">{c.title}</span>
                <span class="c-meta">{c.issuer}</span>
                <Icon name="arrowUpRight" size={15} />
                <span class="sr-only">— verify on Credly (opens in new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
      <p class="certs-note">{certificationTotal} credentials in total, verifiable on Credly.</p>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .about-bio { display: grid; gap: 0.9rem; color: var(--ink-2); max-width: 46ch; }
  .bio-lead { font: 400 1.55rem/1.25 var(--font-serif); color: var(--ink); letter-spacing: -0.01em; }
  .about-col { display: grid; gap: 0.25rem; min-width: 0; }
  .col-title { display: flex; align-items: center; gap: 0.45rem; font-size: 0.92rem; font-weight: 650; margin: 1.1rem 0 0.35rem; }
  .col-title:first-child { margin-top: 0; }
  .col-title :global(svg) { color: var(--accent); }
  .timeline { padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .timeline li { padding-left: 0.95rem; border-left: 1px solid var(--line-strong); }
  .timeline.compact { gap: 0.55rem; }
  .t-role { font-weight: 600; font-size: 0.9rem; line-height: 1.4; }
  .t-meta { color: var(--muted); font-size: 0.82rem; }
  .t-note { color: var(--ink-2); font-size: 0.84rem; margin-top: 0.2rem; line-height: 1.5; }

  .certs { padding: 0; list-style: none; }
  .certs li { border-bottom: 1px solid var(--line); }
  .certs a {
    display: grid; grid-template-columns: minmax(0, 1fr) 16px; gap: 0.1rem 0.75rem; align-items: center;
    padding: 0.65rem 0.1rem; text-decoration: none; min-height: 44px;
  }
  .certs a :global(svg) { grid-column: 2; grid-row: 1 / span 2; color: var(--muted); transition: transform 0.18s var(--ease-out), color 0.18s; }
  .certs a:hover :global(svg) { color: var(--accent); transform: translate(2px, -2px); }
  .certs a:hover .c-title { color: var(--accent); }
  .c-title { font-weight: 600; font-size: 0.88rem; line-height: 1.35; }
  .c-meta { color: var(--muted); font-size: 0.78rem; }
  .more summary {
    display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.6rem; min-height: 40px;
    cursor: pointer; list-style: none; font-weight: 600; font-size: 0.875rem; color: var(--accent);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary :global(svg) { transition: transform 0.2s var(--ease-out); }
  .more[open] summary :global(svg) { transform: rotate(180deg); }
  .more .s-open, .more[open] .s-closed { display: none; }
  .more[open] .s-open { display: inline; }
  .certs-more { max-height: 320px; overflow-y: auto; overscroll-behavior: contain; padding-right: 0.25rem; }
  .certs-note { margin-top: 0.6rem; color: var(--muted); font-size: 0.8rem; }

  @media (max-width: 980px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
    .about-bio { grid-column: 1 / -1; max-width: 62ch; }
  }
  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
