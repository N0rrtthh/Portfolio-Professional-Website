---
import Icon from "./Icon.astro";
import { education, experience, leadership } from "../data/site";
---
<section id="about" class="section container" aria-labelledby="about-title">
  <div class="section-head reveal-head">
    <h2 id="about-title" class="section-title reveal-title">About</h2>
  </div>

  <div class="about-grid">
    <div class="about-bio reveal">
      <p class="bio-lead">
        I’m a Computer Science student at Cavite State University who likes building software people actually use.
      </p>
      <p>
        During my internship at BidaBoss Inc. I shipped a franchise order portal that the company still runs today, and for my thesis I co-built WaterWise — an offline multiplayer game tuned to run smoothly on low-spec Android phones.
      </p>
      <p>
        I learn by building: read the docs, ship a working version, then measure it and make it better. I’m looking for an entry-level role where I can do that on a real team.
      </p>
    </div>

    <div class="about-col reveal" style="--i:1">
      <h3 class="col-title"><Icon name="briefcase" size={16} /> Experience</h3>
      <ul class="timeline" role="list">
        {experience.map((e) => (
          <li>
            <p class="t-role">{e.role}</p>
            <p class="t-meta">{e.org} · {e.place} · <span class="num">{e.period}</span></p>
          </li>
        ))}
      </ul>

      <h3 class="col-title"><Icon name="cap" size={16} /> Education</h3>
      <ul class="timeline" role="list">
        {education.map((e) => (
          <li>
            <p class="t-role">{e.degree}</p>
            <p class="t-meta">{e.school} · <span class="num">{e.period}</span></p>
            {e.note && <p class="t-note">{e.note}</p>}
          </li>
        ))}
      </ul>

    </div>

    <div class="about-col reveal" style="--i:2">
      <h3 class="col-title"><Icon name="star" size={16} /> Leadership & communities</h3>
      <ul class="timeline compact" role="list">
        {leadership.map((l) => (
          <li>
            <p class="t-role">{l.role}</p>
            <p class="t-meta">{l.org} · <span class="num">{l.period}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .about-bio { display: grid; gap: 0.9rem; color: var(--ink-2); max-width: 46ch; }
  .bio-lead { font: 600 1.35rem/1.32 var(--font-display); color: var(--ink); letter-spacing: -0.025em; }
  .about-col { display: grid; gap: 0.25rem; min-width: 0; }
  .col-title { display: flex; align-items: center; gap: 0.45rem; font-size: 0.92rem; font-weight: 650; margin: 1.1rem 0 0.35rem; }
  .col-title:first-child { margin-top: 0; }
  .col-title :global(svg) { color: var(--accent); }
  .timeline { padding: 0; list-style: none; display: grid; gap: 0.75rem; }
  .timeline li { padding-left: 0.95rem; border-left: 1px solid var(--line-strong); }
  .timeline.compact { gap: 0.55rem; }
  .t-role { font-weight: 600; font-size: 0.9rem; line-height: 1.4; }
  .t-meta { color: var(--muted); font-size: 0.82rem; }
  .t-note { color: var(--ink-2); font-size: 0.84rem; margin-top: 0.2rem; line-height: 1.5; }


  @media (max-width: 980px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
    .about-bio { grid-column: 1 / -1; max-width: 62ch; }
  }
  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
