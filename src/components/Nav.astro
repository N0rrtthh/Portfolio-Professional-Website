---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import fox from "../assets/fox.png";
import { profile } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { href: "#projects", label: "Projects" },
  { href: "#certifications", label: "Certifications" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <Image src={fox} alt="" width={34} height={34} densities={[1, 2]} class="brand-mark" loading="eager" />
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <button class="icon-btn glass-btn" type="button" data-glass-toggle aria-pressed="false" aria-label="Turn on liquid glass style" aria-keyshortcuts="ArrowDown" aria-describedby="glass-hint">
        <Icon name="droplet" />
        <span id="glass-hint" class="sr-only">Hover, long-press or press Arrow Down for glass settings</span>
      </button>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm nav-resume" href={`${base}${profile.resumeFile}`} download aria-label="Download Resume (PDF)">
        <Icon name="download" /> <span>Resume</span>
      </a>
      <button class="icon-btn menu-btn" type="button" data-menu-btn popovertarget="site-menu" aria-controls="site-menu" aria-expanded="false" aria-label="Section menu">
        <Icon name="menu" class="i-open" />
        <Icon name="x" class="i-close" />
      </button>
    </div>
  </div>
  <!-- A popover renders in the top layer, outside the nav pill, so its own
       glass can see the page behind it (a backdrop filter nested inside the
       pill's would only see the pill). -->
  <nav id="site-menu" class="menu-panel" popover aria-label="Sections">
    {links.map((l) => <a href={l.href} data-menu-link>{l.label}</a>)}
  </nav>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; }
  .nav-inner { display: flex; align-items: center; gap: 0.75rem; }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; margin-right: auto; min-height: 44px; flex-shrink: 0; }
  .brand :global(.brand-mark) { width: 34px; height: 34px; object-fit: contain; transition: transform 0.35s var(--ease-out); }
  .brand:hover :global(.brand-mark) { transform: rotate(-8deg) scale(1.06); }
  .glass-btn[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .brand-name { font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; white-space: nowrap; }

  .nav-links { display: flex; gap: 0.15rem; flex-shrink: 1; min-width: 0; }
  .nav-links a {
    padding: 0.5rem 0.6rem; border-radius: 999px; text-decoration: none;
    font-size: 0.875rem; font-weight: 500; color: var(--muted); white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-links a:hover { color: var(--ink); background: var(--surface-2); }

  .nav-actions { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .theme-btn :global(.i-sun) { display: none; }
  :global([data-theme="dark"]) .theme-btn :global(.i-sun) { display: block; }
  :global([data-theme="dark"]) .theme-btn :global(.i-moon) { display: none; }

  /* ── Section menu (popover) ── */
  .menu-btn { display: none; }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn.is-open :global(.i-close) { display: block; }
  .menu-btn.is-open :global(.i-open) { display: none; }
  .menu-panel {
    /* Reset the UA popover box; site.ts sets --menu-top/--menu-right
       so the panel hangs under the right end of the bar / pill. */
    position: fixed; inset: auto; margin: 0;
    top: var(--menu-top, 70px); right: var(--menu-right, 10px);
    width: min(240px, calc(100vw - 20px)); padding: 0.45rem;
    display: none; gap: 2px; overflow: visible;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    backdrop-filter: blur(20px) saturate(1.5);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 10px 32px -10px rgb(0 0 0 / 0.28), 0 2px 8px rgb(0 0 0 / 0.08);
  }
  /* Separate rules: an unknown :popover-open must not void the fallback. */
  .menu-panel:popover-open { display: grid; animation: menu-in 0.24s var(--ease-out); }
  .menu-panel.is-open { display: grid; animation: menu-in 0.24s var(--ease-out); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px) scale(0.97); } }
  /* Liquid glass (lens.ts → #menu-lens), every theme and mode. */
  .menu-panel:global(.lens-on) {
    background: var(--lens-tint-strong);
    border-color: transparent;
    box-shadow: var(--lens-shadow);
    -webkit-backdrop-filter: url(#menu-lens);
    backdrop-filter: url(#menu-lens);
  }
  .menu-panel a {
    display: flex; align-items: center; min-height: 46px; padding: 0 0.9rem; border-radius: 12px;
    text-decoration: none; font-weight: 550; font-size: 0.98rem; color: var(--ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .menu-panel a:hover, .menu-panel a:focus-visible { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  .menu-panel a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  @media (max-width: 1000px) {
    .nav-links { display: none; }
    .menu-btn { display: inline-grid; }
  }
  @media (max-width: 600px) {
    .nav-inner { gap: 0.5rem; }
    .nav-actions { gap: 0.25rem; }
  }
  @media (max-width: 420px) {
    .brand-name { display: none; }
    .nav-resume span { display: none; }
    .nav-resume { width: 36px; height: 36px; padding: 0; min-width: 0; }
    .nav-resume :global(svg) { margin: 0; }
  }
  @media (max-width: 360px) {
    .nav-resume { display: none; }
  }
</style>
