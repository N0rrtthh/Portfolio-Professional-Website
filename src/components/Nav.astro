---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import fox from "../assets/fox.png";
import { profile } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
  { href: "#projects", label: "Projects" },
  { href: "#certifications", label: "Certifications" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <Image src={fox} alt="" width={34} height={34} densities={[1, 2]} class="brand-mark" loading="eager" />
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <button class="icon-btn glass-btn" type="button" data-glass-toggle aria-pressed="false" aria-label="Turn on liquid glass style" aria-keyshortcuts="ArrowDown" aria-describedby="glass-hint">
        <Icon name="droplet" />
        <span id="glass-hint" class="sr-only">Hover, long-press or press Arrow Down for glass settings</span>
      </button>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm nav-resume" href={`${base}${profile.resumeFile}`} download aria-label="Download résumé (PDF)">
        <Icon name="download" /> <span>Resume</span>
      </a>
      <details class="menu">
        <summary class="icon-btn" aria-label="Open section menu">
          <Icon name="menu" class="i-open" />
          <Icon name="x" class="i-close" />
        </summary>
        <nav class="menu-panel" aria-label="Sections">
          {links.map((l) => <a href={l.href} data-menu-link>{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; align-items: center; gap: 0.75rem; }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; margin-right: auto; min-height: 44px; flex-shrink: 0; }
  .brand :global(.brand-mark) { width: 34px; height: 34px; object-fit: contain; transition: transform 0.35s var(--ease-out); }
  .brand:hover :global(.brand-mark) { transform: rotate(-8deg) scale(1.06); }
  .glass-btn[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .brand-name { font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em; white-space: nowrap; }

  .nav-links { display: flex; gap: 0.15rem; flex-shrink: 1; min-width: 0; }
  .nav-links a {
    padding: 0.5rem 0.6rem; border-radius: 999px; text-decoration: none;
    font-size: 0.875rem; font-weight: 500; color: var(--muted); white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-links a:hover { color: var(--ink); background: var(--surface-2); }

  .nav-actions { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .theme-btn :global(.i-sun) { display: none; }
  :global([data-theme="dark"]) .theme-btn :global(.i-sun) { display: block; }
  :global([data-theme="dark"]) .theme-btn :global(.i-moon) { display: none; }

  /* ── Hamburger menu ── */
  .menu { position: relative; display: none; }
  .menu summary { list-style: none; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu :global(.i-close) { display: none; }
  .menu[open] :global(.i-close) { display: block; }
  .menu[open] :global(.i-open) { display: none; }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 10px);
    min-width: 200px; padding: 0.5rem;
    display: grid;
    /* glass treatment */
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.22), 0 2px 8px rgb(0 0 0 / 0.08);
    animation: menu-in 0.22s var(--ease-out);
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px) scale(0.97); } }
  .menu-panel a {
    padding: 0.75rem 0.9rem; border-radius: 10px;
    text-decoration: none; font-weight: 500; font-size: 0.95rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .menu-panel a:hover { background: color-mix(in srgb, var(--accent) 10%, var(--surface-2)); color: var(--accent); }
  /* liquid glass override for menu-panel */
  :global([data-glass="on"]) .menu-panel {
    background: color-mix(in srgb, var(--surface) 35%, transparent);
    border-color: rgb(255 255 255 / 0.3);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      inset 1px 0 0 rgb(255 255 255 / 0.2),
      inset -1px 0 0 rgb(255 255 255 / 0.1),
      0 8px 32px -8px rgb(20 20 40 / 0.3);
  }
  :global([data-theme="dark"][data-glass="on"]) .menu-panel {
    background: color-mix(in srgb, var(--surface) 30%, transparent);
    border-color: rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 8px 32px -8px rgb(0 0 0 / 0.6);
  }
  :global(.lens-on) .menu-panel {
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
  }

  @media (max-width: 1000px) {
    .nav-links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 600px) {
    .nav-inner { gap: 0.5rem; }
    .nav-actions { gap: 0.25rem; }
  }
  @media (max-width: 420px) {
    .brand-name { display: none; }
    .nav-resume span { display: none; }
    .nav-resume { width: 36px; height: 36px; padding: 0; min-width: 0; }
    .nav-resume :global(svg) { margin: 0; }
  }
  @media (max-width: 360px) {
    .nav-resume { display: none; }
  }
</style>
